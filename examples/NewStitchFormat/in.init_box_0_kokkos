# SPPARKS Kokkos version test - gradient validation
# Based on in.init_box_0 but uses Kokkos app

variable DX equal 5e-6

# Use Kokkos version of app
app_style additive_temperature_texture/kk 1000000 5e-06 3e-6 2

shell mkdir -p DumpFiles_kokkos

seed		 1760655727

dimension	 3
lattice	 	 sc/26n 1.0
region box block -208 229 -115 159 -10 15 # Bounding box in voxels

boundary 	 n n n

create_box	 box
create_sites box
 set          site range 1 1000000
 set          i2 value 0
 set          d6 value 300
 set          d7 value 0
 set          d8 value 0
 set          d9 value 0

sector		 yes
sweep		 random mask no

########Setup temperature reading
setup_temperature_source hdf5_unstructured /Users/Tron/spparks/examples/ReducedTempAM/unstructured/FixedInput/fixed_reduced_thermal_output.hdf5 5e-06 1563.0 300.0

############# Outputs the total temperature sum as a stat
diag_style       array d6 sum d6 max d8 sum d8 max
#############

############# Potts Monte Carlo temperature
temperature	 0.0
#############

############## AM specific parameters
liquidus                1623
solidus                 1563
solid_front_vel         4 -1.0302e-7 1.0533e-4 2.2196e-3 0
nucleation_density      1e11
critical_undercooling   5
undercooling_deviation  3
mean_nuclei_volume      8.4375e-16
nuclei_volume_deviation 1.5625e-17
texture_parameters 0.1 0.9 2.5
misorientation_function 10 5
fast_forward_search_window 0.001

##############
shell cd DumpFiles_kokkos/

stats            2e-4

############# Stitch Dump - output gradients for comparison
dump      dump.id.1 stitch 0.002 am_data_kokkos.st i1 i2 d1 d2 d3 d4 d6 d8 d9
dump_modify dump.id.1 delay 0.002

#Start simulation at new time
reset_time 0.0001

# Short run for gradient validation (just 2ms instead of full 17.4ms)
run   0.002 upto
shell cd ../
