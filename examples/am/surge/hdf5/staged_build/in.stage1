# Stage 1 of a staged build: initialize the first window.
#
# Nothing to read in yet, so the microstructure is seeded directly.  The dump
# creates hdf5_staged.h5 and fixes its origin at this window's lower corner.

seed            111

app_style       potts 100
dimension       3
lattice         sc/26n 1.0
region          box block 0 100 0 40 0 6
create_box      box
create_sites    box
set             site range 1 100

sweep           random
sector          yes
temperature     0.5

stats           1.0
dump            d1 hdf5 1.0 hdf5_staged.h5 site
run             3.0
