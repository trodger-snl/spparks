# AM temperature-field validation deck (see README.md). The temperature
# field is deterministic; compare "diag_style array d6 sum d6 max" between
# the CPU (additive/texture) and Kokkos (additive/texture/kk) apps.
app_style additive/texture 1000000 20e-6 5e-6 2
seed             56789
dimension        3
lattice          sc/26n 1.0
region           box block 0 60 0 40 0 20
boundary         n n n
create_box       box
create_sites     box
set              site range 1 1000000
set              i2 value 1
set              d1 value 0
set              d6 value 573
sector           yes
sweep            random mask no
diag_style       array d6 sum d6 max
temperature      0.0
misorientation_target gradient
liquidus         1573
solidus          1523
solid_front_vel  4 -1.0302e-7 1.0533e-4 2.2196e-3 0
nucleation_density      1e14
critical_undercooling   5
undercooling_deviation  3
mean_nuclei_volume      8.4375e-16
nuclei_volume_deviation 1.5625e-17
setup_temperature_source rosenthal standard 285.0 0.0775 11.2 2.0959e-6 573.0
laser_path start -2.0e-3 0.4e-3 0.4e-3 end 1.1e-3 0.4e-3 speed 1.2 repeats 1
fast_forward_search_window 1e-4
stats            1e-4
run              3.0e-3
