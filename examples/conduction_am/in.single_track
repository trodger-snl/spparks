# Nonlinear conduction temperature source (additive/texture/kk only).
# Two hatched passes over a 30 um powder layer on a dense substrate. The
# thermal grid extends 1 mm past the lattice box in x/y and 1 mm into the
# plate with geometrically stretched cells; the part region outside the box
# is dense below the powder layer. See docs/CONDUCTION_SOURCE.md.
# ~15 s on one gfx1151 GPU (build-verify).
app_style        additive/texture/kk 1000000 5e-6 5e-6 2
seed             56789
dimension        3
lattice          sc/26n 1.0
region           box block 0 200 0 40 0 30
boundary         n n n
create_box       box
create_sites     box
set site range 1 1000000
set i2 value 1
region           substrate block 0 200 0 40 0 24
set i2 value 3 region substrate
region           part block -40 240 -20 60 -400 30
set i1 value 42 region substrate
set d1 value 1.0 region substrate
set d2 value 0.0 region substrate
set d3 value 0.0 region substrate
set d4 value 0.0 region substrate
sector           yes
sweep            color
diag_style       array d6 sum d6 max
temperature      0.0
misorientation_target random_rotation
liquidus         1708
solidus          1675
solid_front_vel  4 -1.0302e-7 1.0533e-4 2.2196e-3 0
nucleation_density      1e14
critical_undercooling   5
undercooling_deviation  3
mean_nuclei_volume      8.4375e-16
nuclei_volume_deviation 1.5625e-17

# Q lambda k alpha T0 cp sx sy sz (Moser standard form), then keywords
setup_temperature_source conduction 340.0 0.355 13.8 3.6166e-6 573.0 483.0 50e-6 50e-6 75e-6 &
    k_powder 0.3 k_table 6 300 13.8 600 20.0 900 24.8 1200 28.4 1500 30.6 1675 31.3 &
    cp_table 7 300 483 473 528 873 595 1073 611 1253 624 1675 714 1708 847 &
    latent 2.9e5 &
    convection 25 300 emissivity 0.4 &
    margin 1e-3 1e-3 1e-3 1e-3 plate 1e-3 &
    part part layer_thickness 30e-6 plate_top -0.2e-3 far_bc fixed

# laser plane at the top face of the top site layer (z = 29.5 dx)
laser_path start 0.15e-3 0.10e-3 0.1475e-3 end 0.85e-3 0.10e-3 speed 1.2 hatch 40e-6 2 serpentine pause 1.0e-3
stats            1e-4
run              2.0e-3
