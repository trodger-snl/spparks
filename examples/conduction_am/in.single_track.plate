# in.single_track.card with a Ti-6Al-4V part on a 316L baseplate: the
# substrate sites are i2 = 6 and take the plate card's thermal properties and
# liquidus (plate_material); sites that resolidify below plate_top return to
# i2 = 6, the rest become Ti64 (i2 = 3). The material values come from the
# cards; the process (no Ti64 process set is complete) is in.single_track's.
# Two hatched passes over a 30 um powder layer on the plate. The
# thermal grid extends 1 mm past the lattice box in x/y and 1 mm into the
# plate with geometrically stretched cells; the part region outside the box
# is dense below the powder layer. See docs/CONDUCTION_SOURCE.md.
# ~15 s on one gfx1151 GPU (build-verify).
app_style        additive/texture/kk 1000000 5e-6 5e-6 1
seed             56789
dimension        3
lattice          sc/26n 1.0
region           box block 0 200 0 40 0 30
boundary         n n n
create_box       box
create_sites     box
set site range 1 1000000
set i2 value 1
region           substrate block 0 200 0 40 0 24
set i2 value 6 region substrate
region           part block -40 240 -20 60 -400 30
set i1 value 42 region substrate
set d1 value 1.0 region substrate
set d2 value 0.0 region substrate
set d3 value 0.0 region substrate
set d4 value 0.0 region substrate
sector           yes
sweep            color
diag_style       array d6 sum d6 max
temperature      0.0
misorientation_target random_rotation
# Material values from the card; deck commands after `material` win.
material         ../../materials/Ti6Al4V.toml
# The Ti64 card has no nucleation values: in.single_track's.
nucleation_density      1e14
critical_undercooling   5
undercooling_deviation  3
mean_nuclei_volume      8.4375e-16
nuclei_volume_deviation 1.5625e-17
smooth_greedy_multiproposal on
smooth_orientation copy
nuclei_smooth off

# lambda, k/cp tables, latent, k_powder and emissivity come from the card;
# the plate's density, k/cp tables, latent, solidus and liquidus from its card.
# plate_top = top face of the substrate layer (z = 24.5 dx)
setup_temperature_source conduction card Q 340 T0 573 spot 50e-6 50e-6 75e-6 &
    layer_thickness 30e-6 convection 25 300 &
    margin 1e-3 1e-3 1e-3 1e-3 plate 1e-3 &
    part part plate_top 122.5e-6 plate_material ../../materials/316L.toml far_bc fixed

# laser plane at the top face of the top site layer (z = 29.5 dx)
laser_path start 0.15e-3 0.10e-3 0.1475e-3 end 0.85e-3 0.10e-3 speed 1.2 hatch 40e-6 2 serpentine pause 1.0e-3
stats            1e-4
run              2.0e-3
