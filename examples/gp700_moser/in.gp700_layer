# GammaPrint-700 PBF-L, one build layer per box (docs/GP700_MOSER_SROD_DECK_PLAN.md).
# Print: 176 W, 1137 mm/s, 80 um spot (D4sigma -> sx=sy=20 um), 80 um hatch,
# 30 um layers, 90 deg interlayer rotation, 473 K preheat (Lamb et al. 2023/2026).
# Material (Met Trans 2026 3DThesis set): k 22.5 W/mK, rho 8650, cp 600 ->
# alpha 4.335e-6 m^2/s, absorptivity 0.9, Tl 1646 K, Ts 1592 K.
# Placeholders (double-underscore tokens) are filled in by run_layers.sh.
variable DX equal 3e-6

app_style additive/texture/kk 1000000 ${DX} __DT__ 2
seed             __SEED__
dimension        3
lattice          sc/26n 1.0
region           box block 0 __NX__ 0 __NX__ __ZLO__ __ZHI__
boundary         n n n
create_box       box
create_sites     box
__INIT_OR_STITCH__
sector           yes
sweep            color
diag_style       array d6 sum d6 max
temperature      0.0

liquidus         1646
solidus          1592
# ct15 (304L) V(dT) polynomial scaled 3.5x so the front keeps up with the
# 1.137 m/s scan at ~30 K undercooling (Plan 2 5.1); V(50 K) = 1.27 m/s.
solid_front_vel  4 -3.6057e-7 3.68655e-4 7.7686e-3 0
# 3e13: ~1000 nuclei per layer; 1e12 gave no surviving originating grains
# (Lamb: 5 originating per established grain after the size filters).
nucleation_density      3e13
critical_undercooling   5
undercooling_deviation  2
mean_nuclei_volume      8.4375e-16
nuclei_volume_deviation 1.5625e-17
texture_parameters 1.0 2.5
smooth_greedy_multiproposal on
nuclei_smooth off

# Input D = 0.14 deg^2/um: the walk accumulates along the growth path and through
# smoothing, so the first build (input 0.42) measured 3.6x that against height
# (docs/gp700_results_v2). Lamb's fit is 0.42 deg^2/um vs height.
misorientation_diffusion 1.4e5 30
misorientation_target random_rotation
nucleation_misorientation_target on

# reset_time BEFORE laser_path: the scan is anchored at the current sim time.
reset_time       __T0__
setup_temperature_source moser 176 0.9 22.5 4.335e-6 473 600 20e-6 20e-6 10e-6
__LASER__
fast_forward_search_window 1e-4
stats            2e-4

dump             dump.id.1 stitch __T1__ __STITCH__ i1 i2 d1 d2 d3 d4 d8 d9
dump_modify      dump.id.1 delay __T1__
run              __T1__ upto
