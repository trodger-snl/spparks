# SPPARKS additive_temperature_texture driven by the analytical
# Rosenthal solution with a stochastic ΔW/W, ΔD/D modulation of the
# anisotropic shape factors. This example loads a hand-written
# step-function fixture (`fluct_test_step.dat`) that flips ΔW from 0 to
# +0.20 at the midpoint of the 1-mm path, producing a visibly wider
# pool in the second half of the scan.
#
# Material and laser parameters match `in.additive.rosenthal_standard`.
# `rosenthal_fluctuations` auto-promotes the STANDARD source to
# ANISOTROPIC with eta_y=eta_z=1; the modulated etas are then
# eta_y_eff = (1 - dW/W), eta_z_eff = (1 - dD/D).

app_style additive_temperature_texture 1000000 20e-6 5e-6 2

shell mkdir -p DumpFiles_rosenthal_fluctuations

seed             56789

dimension        3
lattice          sc/26n 1.0
region           box block 0 60 0 40 0 20

boundary         n n n

create_box       box
create_sites     box
 set             site range 1 1000000
 set             i2 value 1
 set             d1 value 0
 set             d2 value 573

sector           yes
sweep            random mask no

diag_style       array d6 sum

temperature      0.0
misorientation_target gradient

liquidus         1573
solidus          1523
solid_front_vel  4 -1.0302e-7 1.0533e-4 2.2196e-3 0
nucleation_density      1e14
critical_undercooling   5
undercooling_deviation  3
mean_nuclei_volume      8.4375e-16
nuclei_volume_deviation 1.5625e-17

# Rosenthal source: standard (auto-promoted to anisotropic by
# rosenthal_fluctuations below).
setup_temperature_source rosenthal standard 285.0 0.0775 11.2 2.0959e-6 573.0

# Single 1 mm linear scan at 1.2 m/s.
rosenthal_path start 0.1e-3 0.4e-3 0.4e-3 end 1.1e-3 0.4e-3 speed 1.2 repeats 1

# Load ΔW/W, ΔD/D vs. arc length. Step function at s = 0.5 mm.
# `mode periodic` (default) wraps the noise on each repeat; use
# `mode continuous` for non-repeating tracks generated by the Python
# generator in scripts/generate_fluctuations.py.
rosenthal_fluctuations fluct_test_step.dat mode periodic

shell cd DumpFiles_rosenthal_fluctuations

stats            1e-4

dump             1 text 2e-4 dump.rosenthal.* id i1 i2 d6 x y z
dump_modify      1 thresh i2 > 1

run              2e-3
shell cd ../
